# Copie para .env no ambiente local. NUNCA publique este arquivo.
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://usuario:senha@localhost:5432/portal_eb
SESSION_SECRET=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres

# Crie uma aplicação OAuth no Creator Dashboard do Roblox.
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=http://localhost:3000/auth/roblox/callback

# Grupo EB do Fake
ROBLOX_GROUP_ID=376496824

# O administrador é identificado pelo ID imutável da conta, não pelo nome.
# Descubra o ID de yImperador e informe aqui.
ADMIN_ROBLOX_USER_ID=
